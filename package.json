{
  "name": "arcode",
  "productName": "ARcode",
  "version": "0.2.0",
  "private": true,
  "description": "A lightweight macOS workspace for Claude Code and other terminal coding agents.",
  "keywords": [
    "claude-code",
    "electron",
    "terminal",
    "ide",
    "macos",
    "coding-agent"
  ],
  "homepage": "https://github.com/andrewrozumny/arcode#readme",
  "bugs": {
    "url": "https://github.com/andrewrozumny/arcode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewrozumny/arcode.git"
  },
  "license": "MIT",
  "author": "Andrey Rozumny",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "postinstall": "install-electron && electron-rebuild -f -w node-pty",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir",
    "screenshots": "electron-vite build && node scripts/demo/screenshots.mjs",
    "bench": "vitest bench --run",
    "bench:app": "electron-vite build && node scripts/bench/run.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "dompurify": "^3.4.16",
    "ignore": "^7.0.12",
    "marked": "^18.1.0",
    "node-pty": "1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@eslint/js": "9.39.5",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.0.0",
    "playwright-core": "1.56.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty",
      "esbuild"
    ]
  }
}
